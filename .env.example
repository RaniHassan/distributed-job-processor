# Copy to .env (git-ignored) and fill in. Never commit .env.
POSTGRES_DB=jobprocessor
POSTGRES_USER=jobprocessor
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432
APP1_PORT=8081
APP2_PORT=8082
SPRING_PROFILES_ACTIVE=dev

# HS256 signing key, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# Users seeded by the dev profile only. Passwords are required when the dev profile is active.
SEED_USER_USERNAME=alice
SEED_USER_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
