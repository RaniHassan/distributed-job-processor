# Local configuration for `docker compose`. Copy this file to `.env` (which is git-ignored)
# and fill in the four REQUIRED values. Never commit `.env`.
#
# Generate random values (see README for the full commands):
#   macOS / Linux / Git Bash:  openssl rand -hex 32
#   Windows PowerShell:        any long random string, e.g. the README's PowerShell snippet
# Use letters and digits only; avoid quotes, spaces, '$' and '#'.

# --- REQUIRED ---------------------------------------------------------------------------------
# Password of the PostgreSQL user (used by the database container and both app instances).
POSTGRES_PASSWORD=
# HS256 signing key for access tokens, at least 32 characters. Same value for every instance.
JWT_SECRET=
# Passwords of the two users created at startup by the dev profile (you log in with these).
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=

# --- OPTIONAL (safe defaults) -----------------------------------------------------------------
# Usernames of the seeded users: SEED_USER_USERNAME has role USER, SEED_ADMIN_USERNAME role ADMIN.
SEED_USER_USERNAME=alice
SEED_ADMIN_USERNAME=admin
# Database name and user created in the PostgreSQL container.
POSTGRES_DB=jobprocessor
POSTGRES_USER=jobprocessor
# Host ports (bound to 127.0.0.1). Change them if they are already in use on your machine.
POSTGRES_HOST_PORT=5432
APP1_PORT=8081
APP2_PORT=8082
# Spring profile: `dev` seeds the users above and allows simulated failure injection.
SPRING_PROFILES_ACTIVE=dev
